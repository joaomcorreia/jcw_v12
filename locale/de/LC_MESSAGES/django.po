msgstr "Öffentliche Website öffnen"

msgid "Plan assignment"
msgstr "Tarifzuweisung"

msgid "Visibility settings"
msgstr "Sichtbarkeitseinstellungen"

msgid "Visibility mode is synced to the current plan unless overridden."
msgstr ""
"Der Sichtbarkeitsmodus wird mit dem aktuellen Tarif synchronisiert, sofern "
"keine manuelle Überschreibung festgelegt wurde."

msgid "Current mode"
msgstr "Aktueller Modus"

msgid "(Synced)"
msgstr "(Synchronisiert)"

msgid "Override mode"
msgstr "Modus überschreiben"

msgid "Allowed countries"
msgstr "Zulässige Länder"

